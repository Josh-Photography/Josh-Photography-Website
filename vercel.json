
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "app",
        "path": "/admin.html"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "app",
        "path": "/admin.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app",
        "path": "/index.html"
      }
    }
  ]
}


