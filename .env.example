# ============================================================
# JOSH PHOTOGRAPHY ENVIRONMENT CONFIGURATION
# ============================================================

# PORT (Vite client + Express API unified on port 3000)
PORT=3000

# JWT Authentication Secret for Admin Sessions
JWT_SECRET=josh-photography-secret-key-2024

# PERSISTENT CLOUD IMAGE STORAGE (CLOUDINARY)
# When set, all uploaded portfolio photos, hero slides, and promotional banners
# are stored permanently on Cloudinary CDN and delivered over global HTTPS.
# If omitted or offline, uploads automatically fallback to local storage (/uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

