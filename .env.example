# ============================================================
# JOSH PHOTOGRAPHY ENVIRONMENT CONFIGURATION
# ============================================================

# PORT (Vite client + Express API unified on port 3000)
PORT=3000

# JWT Authentication Secret for Admin Sessions
JWT_SECRET=your-secret-jwt-key

# ============================================================
# CLOUDINARY CONFIGURATION (PERSISTENT GLOBAL CDN)
# ============================================================

# Server-Side Credentials (for Express API signed uploads & deletions)
# Configure these in your hosting server environment (do not expose to frontend)
CLOUDINARY_CLOUD_NAME=y5l55yxi
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=josh_photography

# Client-Side Public Variables (For Netlify dashboard & Vite builds)
# Safe for frontend - enables direct unsigned uploads from the browser
VITE_CLOUDINARY_CLOUD_NAME=y5l55yxi
VITE_CLOUDINARY_UPLOAD_PRESET=josh_photography
